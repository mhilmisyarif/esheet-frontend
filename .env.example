# ── esheet-frontend environment ─────────────────────────────────────────────
# Copy to ".env" (or ".env.production") and adjust before building.
# Only variables prefixed with VITE_ are exposed to the app.

# Base URL of the e-Sheet backend API, including the /api path.
# Dev default when unset: http://localhost:5000/api
# Production example:     https://api.your-domain.com/api
VITE_API_URL=http://localhost:5000/api
